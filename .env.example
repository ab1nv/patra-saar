# --- LLM ---
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Max output tokens per reply. The Groq free tier caps output tokens per minute
# (1000), so keep this comfortably under that. Default 700.
GROQ_MAX_TOKENS=700

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-32-byte-random-string

# --- Database (Neon Postgres) ---
# Neon pooled connection string, e.g.
# postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Demo user (seeded by `pnpm seed`) ---
DEMO_USER_EMAIL=abhinav@test.com
DEMO_USER_PASSWORD=abhinav

# --- Site URL (canonical/OpenGraph metadata; optional in dev) ---
NEXT_PUBLIC_SITE_URL=https://patrasaar.ab1nv.dev
